{
  "name": "melonbuild-cli",
  "version": "0.1.0",
  "description": "MelonBuild CLI：登录 Figma，获取设计稿的结构化 AST，并把图片下载到本地",
  "type": "module",
  "bin": {
    "melonbuild": "dist/cli.mjs",
    "melonbuild-cli": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "figma",
    "design-to-code",
    "ast",
    "cli",
    "melonbuild"
  ],
  "homepage": "https://www.melonbuild.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1977474741/melonbuild-cli.git"
  },
  "bugs": {
    "url": "https://github.com/1977474741/melonbuild-cli/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@jsquash/oxipng": "2.3.0",
    "esbuild": "0.25.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT"
}
